{
  "name": "nha-minh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/prepare-whiteboard-assets.mjs && next dev",
    "build": "node scripts/prepare-whiteboard-assets.mjs && next build",
    "build:e2e": "node scripts/build-e2e.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare:whiteboard-assets": "node scripts/prepare-whiteboard-assets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:e2e && pnpm test:e2e"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "idb": "^8.0.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.4",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18"
  }
}
