# Optional only while running the public bootstrap shell.
# Set both values together to enable real Supabase clients.
# Copy the HTTPS project origin and modern sb_publishable_ key from Supabase.
# Local Supabase may use http://127.0.0.1:54321 and its publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never put a secret key, service-role JWT, or signing secret in NEXT_PUBLIC_*.
# Server-only secret for validated private photo uploads. Never prefix NEXT_PUBLIC_.
# Other features work without it; Photo Mission upload requires this configuration.
SUPABASE_SECRET_KEY=

# Optional background push. Private values belong only on the server.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
PUSH_DISPATCH_SECRET=
